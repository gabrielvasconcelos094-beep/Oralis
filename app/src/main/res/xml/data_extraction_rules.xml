<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy: nothing is uploaded to cloud backups (texts, audio, model). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" path="model/" />
    </device-transfer>
</data-extraction-rules>
